<x-layouts::app title="AACCUP Monitoring">
    <div class="px-6 py-8 w-full max-w-[100vw] overflow-hidden" x-data="{ 
        activeTab: new URLSearchParams(window.location.search).get('tab') || 'overview',
        selectedProgram: null,
        viewProgram(programName) {
            this.selectedProgram = programName;
            this.activeTab = 'program';
        }
    }">
        <!-- Header Section -->
        <div class="mb-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div>
                <div class="flex items-center gap-3 mb-1">
                    <span class="bg-blue-100 text-blue-800 text-label-xs font-bold px-2 py-0.5 rounded uppercase tracking-wider">Preview</span>
                    <h1 class="text-heading-lg font-bold text-primary-dark tracking-tight leading-none">Accreditation Monitoring</h1>
                </div>
                <p class="text-body-sm text-primary-muted mt-1">Master tracker for AACCUP Technical Reviews, Program Status, and Board Actions.</p>
            </div>
            
            <div class="flex items-center gap-3">
                <button class="bg-white border border-slate-200 text-body-sm px-4 py-2 rounded-lg shadow-sm hover:bg-slate-50 flex items-center gap-2 font-medium text-slate-700 transition-colors">
                    <flux:icon.arrow-down-tray class="w-4 h-4 text-slate-500" />
                    Export Excel
                </button>
                <button class="bg-brand-orange text-white text-body-sm px-4 py-2 rounded-lg shadow-sm hover:bg-brand-orange-hover flex items-center gap-2 font-medium transition-colors">
                    <flux:icon.plus class="w-4 h-4" />
                    Record Visit
                </button>
            </div>
        </div>
        

        <!-- TAB 1: Programs Overview -->
        <div x-show="activeTab === 'overview'" x-transition x-cloak class="flex flex-col gap-6">
            <!-- Filters -->
            <div class="bg-surface-card rounded-xl border border-slate-200 p-4 flex flex-wrap items-center gap-4 shadow-sm">
                <div class="flex-1 min-w-45">
                    <label class="text-label-xs font-bold text-primary-muted uppercase tracking-wider mb-1.5 block">College / Unit</label>
                    <select class="w-full border border-slate-200 rounded-lg text-body-sm py-2 px-3 focus:ring-brand-orange focus:border-brand-orange bg-white shadow-sm font-medium text-zinc-700">
                        <option>All Colleges</option>
                        <option selected>BUCAL</option>
                        <option>BENG</option>
                    </select>
                </div>
                <div class="flex-1 min-w-45">
                    <label class="text-label-xs font-bold text-primary-muted uppercase tracking-wider mb-1.5 block">Accreditation Level</label>
                    <select class="w-full border border-slate-200 rounded-lg text-body-sm py-2 px-3 focus:ring-brand-orange focus:border-brand-orange bg-white shadow-sm font-medium text-zinc-700">
                        <option>All Levels</option>
                        <option>Level I</option>
                        <option>Level II</option>
                        <option>Level III</option>
                        <option>Level IV</option>
                    </select>
                </div>
                <div class="flex-1 min-w-45">
                    <label class="text-label-xs font-bold text-primary-muted uppercase tracking-wider mb-1.5 block">Search Program</label>
                    <div class="relative">
                        <flux:icon.magnifying-glass class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
                        <input type="text" placeholder="Search by name..." class="w-full border border-slate-200 rounded-lg text-body-sm py-2 pl-9 pr-3 focus:ring-brand-orange focus:border-brand-orange bg-white shadow-sm placeholder:text-slate-400" />
                    </div>
                </div>
            </div>

            <!-- Directory Table -->
            <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden flex flex-col">
                <table class="w-full text-left border-collapse whitespace-nowrap">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200 text-label uppercase tracking-wider text-slate-500">
                            <th class="px-4 py-3 font-bold">College</th>
                            <th class="px-4 py-3 font-bold">Program</th>
                            <th class="px-4 py-3 font-bold">Current Level</th>
                            <th class="px-4 py-3 font-bold text-center">Validity</th>
                            <th class="px-4 py-3 font-bold text-center">Status</th>
                            <th class="px-4 py-3 font-bold text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-body-sm text-zinc-700">
                        <!-- Row 1 -->
                        <tr class="hover:bg-slate-50 transition-colors group cursor-pointer" @click="viewProgram('MA in Literature')">
                            <td class="px-4 py-3 font-bold text-primary">BUCAL</td>
                            <td class="px-4 py-3 font-semibold text-zinc-800">Master of Arts in Literature</td>
                            <td class="px-4 py-3">
                                <span class="bg-primary-light text-white px-2 py-0.5 rounded text-xs font-bold">Level III</span>
                            </td>
                            <td class="px-4 py-3 text-center text-zinc-600 font-mono text-[11px]">Dec 16, 2023 - Dec 15, 2024</td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-label-xs font-bold tracking-wider uppercase bg-rose-100 text-rose-700">Late</span>
                            </td>
                            <td class="px-4 py-3 text-right">
                                <button class="text-brand-orange font-semibold hover:text-brand-orange-hover flex items-center justify-end gap-1 w-full">
                                    History <flux:icon.chevron-right class="w-3 h-3" />
                                </button>
                            </td>
                        </tr>
                        <!-- Row 2 -->
                        <tr class="hover:bg-slate-50 transition-colors group cursor-pointer" @click="viewProgram('BA in Speech & Theater')">
                            <td class="px-4 py-3 font-bold text-primary">BUCAL</td>
                            <td class="px-4 py-3 font-semibold text-zinc-800">Bachelor of Arts in Speech & Theater</td>
                            <td class="px-4 py-3">
                                <span class="bg-primary text-white px-2 py-0.5 rounded text-xs font-bold">Level IV</span>
                            </td>
                            <td class="px-4 py-3 text-center text-zinc-600 font-mono text-[11px]">July 16, 2018 - July 15, 2022</td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-label-xs font-bold tracking-wider uppercase bg-emerald-100 text-emerald-700">Timely</span>
                            </td>
                            <td class="px-4 py-3 text-right">
                                <button class="text-brand-orange font-semibold hover:text-brand-orange-hover flex items-center justify-end gap-1 w-full">
                                    History <flux:icon.chevron-right class="w-3 h-3" />
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="px-4 py-3 border-t border-slate-200 bg-slate-50/80 text-body-sm text-zinc-500 flex justify-between items-center">
                    <span>Showing 2 of 126 programs</span>
                </div>
            </div>
        </div>

        <!-- TAB 2: Program Accreditation (Detailed Matrix) -->
        <div x-show="activeTab === 'program'" x-transition x-cloak class="flex flex-col gap-6">
            <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden flex flex-col relative w-full">
                <div class="px-4 py-3 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
                    <div class="font-bold text-primary-dark flex items-center gap-2">
                        <flux:icon.document-text class="w-4 h-4 text-primary" />
                        Accreditation History: <span x-text="selectedProgram"></span>
                    </div>
                    <button @click="activeTab = 'overview'" class="text-sm font-semibold text-zinc-500 hover:text-zinc-800">Back to Overview</button>
                </div>
                <div class="overflow-x-auto w-full custom-scrollbar pb-2">
                    <table class="w-full text-left border-collapse whitespace-nowrap min-w-max">
                        <thead>
                            <tr class="bg-primary-dark text-white text-label uppercase tracking-wider divide-x divide-white/10">
                                <th colspan="4" class="px-4 py-2 text-center border-b border-white/20 font-bold bg-primary">Date of Visit</th>
                                <th colspan="4" class="px-4 py-2 text-center border-b border-white/20 font-bold bg-primary-hover">Rating</th>
                                <th colspan="2" class="px-4 py-2 text-center border-b border-white/20 font-bold bg-primary-light">Validity Duration</th>
                                <th rowspan="2" class="px-4 py-3 text-center bg-primary-light font-bold">Timeliness</th>
                                <th rowspan="2" class="px-4 py-3 bg-primary-light font-bold max-w-62.5">Remarks</th>
                            </tr>
                            <tr class="text-white text-label-xs tracking-wider divide-x divide-white/10">
                                <th class="px-4 py-2 text-center bg-primary font-medium">Prelim Survey</th>
                                <th class="px-4 py-2 text-center bg-primary font-medium">1st Visit</th>
                                <th class="px-4 py-2 text-center bg-primary font-medium">2nd Visit</th>
                                <th class="px-4 py-2 text-center bg-primary font-medium">3rd Visit (Ph1)</th>
                                <th class="px-4 py-2 text-center bg-primary-hover font-medium">Prelim</th>
                                <th class="px-4 py-2 text-center bg-primary-hover font-medium">1st</th>
                                <th class="px-4 py-2 text-center bg-primary-hover font-medium">2nd</th>
                                <th class="px-4 py-2 text-center bg-primary-hover font-medium">3rd (Ph1)</th>
                                <th class="px-4 py-2 text-center bg-primary-light font-medium">Start</th>
                                <th class="px-4 py-2 text-center bg-primary-light font-medium">End</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 text-body-sm text-zinc-700">
                            <!-- Example Row -->
                            <tr class="hover:bg-slate-50/80 divide-x divide-slate-100 transition-colors">
                                <td class="px-4 py-3 text-center">July 12-15, 2011</td>
                                <td class="px-4 py-3 text-center bg-green-50/30">July 2-5, 2013</td>
                                <td class="px-4 py-3 text-center bg-amber-50/30">Nov 8-11, 2017</td>
                                <td class="px-4 py-3 text-center bg-blue-50/30">Nov 21-25, 2022</td>
                                <td class="px-4 py-3 text-center font-medium">4.01</td>
                                <td class="px-4 py-3 text-center font-medium bg-green-50/30">3.62</td>
                                <td class="px-4 py-3 text-center font-medium bg-amber-50/30">3.63</td>
                                <td class="px-4 py-3 text-center bg-blue-50/30 relative">
                                    <span class="font-bold text-primary">4.03</span>
                                    <div class="text-label-xs text-zinc-500 mt-0.5 uppercase tracking-wide">revisit VI</div>
                                </td>
                                <td class="px-4 py-3 text-center text-zinc-600 font-mono text-[11px]">Dec 16, 2023</td>
                                <td class="px-4 py-3 text-center text-zinc-600 font-mono text-[11px]">Dec 15, 2024</td>
                                <td class="px-4 py-3 text-center bg-slate-50/50">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-label-xs font-bold tracking-wider uppercase bg-rose-100 text-rose-700 border border-rose-200">Late</span>
                                </td>
                                <td class="px-4 py-3 text-zinc-600 text-[11px] max-w-62.5 whitespace-normal leading-relaxed bg-slate-50/50">Requested for Resched of Visit on Aug 27-29, 2025</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 3: Summary Report -->
        <div x-show="activeTab === 'summary'" x-transition x-cloak class="flex flex-col gap-6">
            <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden flex flex-col relative w-full">
                <div class="px-4 py-4 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
                    <div>
                        <h2 class="font-bold text-primary-dark">AACCUP Technical Review & Board Action Summary</h2>
                        <p class="text-xs text-zinc-500 mt-0.5">Yearly breakdown by college</p>
                    </div>
                </div>
                <div class="overflow-x-auto w-full custom-scrollbar pb-2">
                    <table class="w-full text-left border-collapse whitespace-nowrap min-w-max">
                        <thead>
                            <tr class="bg-primary-dark text-white text-label uppercase tracking-wider divide-x divide-white/20">
                                <th rowspan="2" class="px-4 py-3 sticky left-0 z-20 bg-primary-dark shadow-[4px_0_12px_rgba(0,0,0,0.15)] font-bold border-r border-white/20">College</th>
                                <!-- 2021 -->
                                <th colspan="6" class="px-4 py-2 text-center border-b border-white/20 font-bold bg-primary">2021</th>
                                <!-- 2022 -->
                                <th colspan="6" class="px-4 py-2 text-center border-b border-white/20 font-bold bg-primary-hover">2022</th>
                                <!-- 2023 -->
                                <th colspan="6" class="px-4 py-2 text-center border-b border-white/20 font-bold bg-primary">2023</th>
                                <!-- Pending -->
                                <th colspan="2" class="px-4 py-2 text-center border-b border-white/20 font-bold bg-primary-light">Pending</th>
                            </tr>
                            <tr class="text-white text-label-xs font-bold tracking-wider divide-x divide-white/20">
                                <!-- 2021 -->
                                <th class="px-2 py-2 text-center bg-primary" title="Programs Visited">Visits</th>
                                <th class="px-2 py-2 text-center bg-emerald-600">Timely</th>
                                <th class="px-2 py-2 text-center bg-amber-600">Not</th>
                                <th class="px-2 py-2 text-center bg-emerald-500">Passed</th>
                                <th class="px-2 py-2 text-center bg-amber-500">Deferred</th>
                                <th class="px-2 py-2 text-center bg-rose-500">Revisit</th>
                                <!-- 2022 -->
                                <th class="px-2 py-2 text-center bg-primary-hover" title="Programs Visited">Visits</th>
                                <th class="px-2 py-2 text-center bg-emerald-600">Timely</th>
                                <th class="px-2 py-2 text-center bg-amber-600">Not</th>
                                <th class="px-2 py-2 text-center bg-emerald-500">Passed</th>
                                <th class="px-2 py-2 text-center bg-amber-500">Deferred</th>
                                <th class="px-2 py-2 text-center bg-rose-500">Revisit</th>
                                <!-- 2023 -->
                                <th class="px-2 py-2 text-center bg-primary" title="Programs Visited">Visits</th>
                                <th class="px-2 py-2 text-center bg-emerald-600">Timely</th>
                                <th class="px-2 py-2 text-center bg-amber-600">Not</th>
                                <th class="px-2 py-2 text-center bg-emerald-500">Passed</th>
                                <th class="px-2 py-2 text-center bg-amber-500">Deferred</th>
                                <th class="px-2 py-2 text-center bg-rose-500">Revisit</th>
                                <!-- Pending -->
                                <th class="px-4 py-2 text-center bg-primary-light">Count</th>
                                <th class="px-4 py-2 text-center bg-primary-light">Target Date</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 text-body-sm text-zinc-700">
                            <!-- BUCAL -->
                            <tr class="hover:bg-slate-50/80 divide-x divide-slate-200 transition-colors group">
                                <td class="px-4 py-3 sticky left-0 z-10 bg-white group-hover:bg-slate-50/90 shadow-[4px_0_12px_rgba(0,0,0,0.03)] font-bold text-primary border-r border-slate-200">BUCAL</td>
                                <!-- 2021 -->
                                <td class="px-3 py-2 text-center font-bold text-zinc-400 bg-slate-50">0</td>
                                <td class="px-3 py-2 text-center"></td>
                                <td class="px-3 py-2 text-center"></td>
                                <td class="px-3 py-2 text-center"></td>
                                <td class="px-3 py-2 text-center"></td>
                                <td class="px-3 py-2 text-center"></td>
                                <!-- 2022 -->
                                <td class="px-3 py-2 text-center font-bold text-zinc-800 bg-slate-50">3</td>
                                <td class="px-3 py-2 text-center text-emerald-600 font-medium">3</td>
                                <td class="px-3 py-2 text-center text-zinc-300">0</td>
                                <td class="px-3 py-2 text-center text-zinc-300">0</td>
                                <td class="px-3 py-2 text-center text-zinc-300">0</td>
                                <td class="px-3 py-2 text-center text-rose-600 font-medium">3</td>
                                <!-- 2023 -->
                                <td class="px-3 py-2 text-center font-bold text-zinc-800 bg-slate-50">6</td>
                                <td class="px-3 py-2 text-center text-emerald-600 font-medium">3</td>
                                <td class="px-3 py-2 text-center text-amber-600 font-medium">3</td>
                                <td class="px-3 py-2 text-center text-emerald-600 font-medium">4</td>
                                <td class="px-3 py-2 text-center text-amber-600 font-medium">1</td>
                                <td class="px-3 py-2 text-center text-rose-600 font-medium">1</td>
                                <!-- Pending -->
                                <td class="px-4 py-2 text-center font-bold text-primary">1</td>
                                <td class="px-4 py-2 text-center text-zinc-500 text-xs">July 2024</td>
                            </tr>
                            <!-- BUCE -->
                            <tr class="hover:bg-slate-50/80 divide-x divide-slate-200 transition-colors group">
                                <td class="px-4 py-3 sticky left-0 z-10 bg-white group-hover:bg-slate-50/90 shadow-[4px_0_12px_rgba(0,0,0,0.03)] font-bold text-primary border-r border-slate-200">BUCE</td>
                                <!-- 2021 -->
                                <td class="px-3 py-2 text-center font-bold text-zinc-400 bg-slate-50">0</td>
                                <td class="px-3 py-2 text-center"></td>
                                <td class="px-3 py-2 text-center"></td>
                                <td class="px-3 py-2 text-center"></td>
                                <td class="px-3 py-2 text-center"></td>
                                <td class="px-3 py-2 text-center"></td>
                                <!-- 2022 -->
                                <td class="px-3 py-2 text-center font-bold text-zinc-800 bg-slate-50">4</td>
                                <td class="px-3 py-2 text-center text-emerald-600 font-medium">2</td>
                                <td class="px-3 py-2 text-center text-amber-600 font-medium">2</td>
                                <td class="px-3 py-2 text-center text-emerald-600 font-medium">2</td>
                                <td class="px-3 py-2 text-center text-zinc-300">0</td>
                                <td class="px-3 py-2 text-center text-rose-600 font-medium">2</td>
                                <!-- 2023 -->
                                <td class="px-3 py-2 text-center font-bold text-zinc-800 bg-slate-50">4</td>
                                <td class="px-3 py-2 text-center text-emerald-600 font-medium">3</td>
                                <td class="px-3 py-2 text-center text-amber-600 font-medium">1</td>
                                <td class="px-3 py-2 text-center text-emerald-600 font-medium">3</td>
                                <td class="px-3 py-2 text-center text-zinc-300">0</td>
                                <td class="px-3 py-2 text-center text-rose-600 font-medium">1</td>
                                <!-- Pending -->
                                <td class="px-4 py-2 text-center font-bold text-primary">12</td>
                                <td class="px-4 py-2 text-center text-zinc-500 text-xs">July, Dec 2024</td>
                            </tr>
                            
                             <!-- Totals Row -->
                            <tr class="divide-x divide-slate-300 bg-slate-100 border-t-2 border-slate-300">
                                <td class="px-4 py-3 sticky left-0 z-10 bg-slate-100 shadow-[4px_0_12px_rgba(0,0,0,0.03)] font-extrabold text-primary border-r border-slate-300">Total Visited</td>
                                <!-- 2021 -->
                                <td class="px-3 py-2 text-center font-bold text-zinc-800 bg-slate-200">14</td>
                                <td class="px-3 py-2 text-center font-bold text-emerald-700">6</td>
                                <td class="px-3 py-2 text-center font-bold text-amber-700">8</td>
                                <td class="px-3 py-2 text-center font-bold text-emerald-700">13</td>
                                <td class="px-3 py-2 text-center font-bold text-amber-700">0</td>
                                <td class="px-3 py-2 text-center font-bold text-rose-700">1</td>
                                <!-- 2022 -->
                                <td class="px-3 py-2 text-center font-bold text-zinc-800 bg-slate-200">19</td>
                                <td class="px-3 py-2 text-center font-bold text-emerald-700">7</td>
                                <td class="px-3 py-2 text-center font-bold text-amber-700">12</td>
                                <td class="px-3 py-2 text-center font-bold text-emerald-700">12</td>
                                <td class="px-3 py-2 text-center font-bold text-amber-700">0</td>
                                <td class="px-3 py-2 text-center font-bold text-rose-700">7</td>
