                                <td class="px-3 py-2 text-center font-bold text-zinc-800 bg-slate-200">41</td>
                                <td class="px-3 py-2 text-center font-bold text-emerald-700">31</td>
                                <td class="px-3 py-2 text-center font-bold text-amber-700">10</td>
                                <td class="px-3 py-2 text-center font-bold text-emerald-700">24</td>
