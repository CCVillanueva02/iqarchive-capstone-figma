<x-layouts::app title="AACCUP Monitoring">
    <div class="px-6 py-8 w-full max-w-[100vw] overflow-hidden" x-data="{ 
        activeTab: new URLSearchParams(window.location.search).get('tab') || 'dashboard',
        selectedProgram: null,
        viewProgram(programName) {
            this.selectedProgram = programName;
            this.activeTab = 'program';
        }
    }">
        <!-- Header Section -->
        <div class="mb-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div>
                <div class="flex items-center gap-3 mb-1">
                 <!-- 0 text-blue-800 text-label-xs font-bold px-2 py-0.5 rounded uppercase tracking-wider">Preview</span>   <span class="bg-blue-10 -->
                    <h1 class="text-heading-lg font-bold text-primary-dark tracking-tight leading-none">Accreditation Monitoring</h1>
                </div>
                <p class="text-body-sm text-primary-muted mt-1">Master tracker for AACCUP Technical Reviews, Program Status, and Board Actions.</p>
            </div>
            
            <div class="flex items-center gap-3">
                <!-- <button class="bg-white border border-slate-200 text-body-sm px-4 py-2 rounded-lg shadow-sm hover:bg-slate-50 flex items-center gap-2 font-medium text-slate-700 transition-colors">
                    <flux:icon.arrow-down-tray class="w-4 h-4 text-slate-500" />
                    Export Excel
                </button> -->
                <!-- <button class="bg-brand-orange text-white text-body-sm px-4 py-2 rounded-lg shadow-sm hover:bg-brand-orange-hover flex items-center gap-2 font-medium transition-colors">
                    <flux:icon.plus class="w-4 h-4" />
                    Record Visit
                </button> -->
            </div>
        </div>
        

        <!-- TAB 0: Dashboard Overview -->
        <div x-show="activeTab === 'dashboard'" x-transition x-cloak class="flex flex-col gap-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                
                <!-- Expiring & Expired Programs -->
                <div class="bg-white border border-slate-200 rounded-xl shadow-sm flex flex-col overflow-hidden">
                    <div class="px-5 py-4 border-b border-slate-200 bg-slate-50">
                        <div class="flex items-center justify-between">
                            <h2 class="font-bold text-primary-dark text-heading-sm flex items-center gap-2">
                                <flux:icon.exclamation-triangle class="w-5 h-5 text-rose-500" />
                                Attention Required
                            </h2>
                            <span class="bg-rose-100 text-rose-700 text-label-xs font-bold px-2 py-0.5 rounded-full">3 Programs</span>
                        </div>
                        <p class="text-sm text-zinc-500 mt-1">Programs nearing expiration or already expired.</p>
                    </div>
                    <div class="p-0 overflow-x-auto">
                        <table class="w-full text-left text-sm border-collapse whitespace-nowrap">
                            <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-500 font-semibold">
                                <tr>
                                    <th class="px-4 py-3">Program</th>
                                    <th class="px-4 py-3">Validity</th>
                                    <th class="px-4 py-3 text-right">Time Left</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <tr class="hover:bg-slate-50 cursor-pointer transition-colors" @click="viewProgram('MA in Literature')">
                                    <td class="px-4 py-3">
                                        <span class="font-bold text-primary">BUCAL</span>
                                        <div class="font-medium text-zinc-800">MA in Literature</div>
                                    </td>
                                    <td class="px-4 py-3 text-zinc-500 text-xs">Dec 15, 2024</td>
                                    <td class="px-4 py-3 text-right">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold uppercase bg-rose-100 text-rose-700 border border-rose-200">Expired</span>
                                    </td>
                                </tr>
                                <tr class="hover:bg-slate-50">
                                    <td class="px-4 py-3">
                                        <span class="font-bold text-primary">BUCE</span>
                                        <div class="font-medium text-zinc-800">BSEd Major in Science</div>
                                    </td>
                                    <td class="px-4 py-3 text-zinc-500 text-xs">Oct 30, 2026</td>
                                    <td class="px-4 py-3 text-right">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold uppercase bg-amber-100 text-amber-700 border border-amber-200">2 mos left</span>
                                    </td>
                                </tr>
                                <tr class="hover:bg-slate-50">
                                    <td class="px-4 py-3">
                                        <span class="font-bold text-primary">BENG</span>
                                        <div class="font-medium text-zinc-800">BS Civil Engineering</div>
                                    </td>
                                    <td class="px-4 py-3 text-zinc-500 text-xs">Jan 12, 2027</td>
                                    <td class="px-4 py-3 text-right">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold uppercase bg-amber-100 text-amber-700 border border-amber-200">5 mos left</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="px-4 py-3 bg-slate-50 border-t border-slate-200 text-center">
                        <button @click="activeTab = 'programs'" class="text-sm font-semibold text-brand-orange hover:text-brand-orange-hover">View all programs &rarr;</button>
                    </div>
                </div>

                <!-- Active Accreditations -->
                <div class="bg-white border border-slate-200 rounded-xl shadow-sm flex flex-col overflow-hidden">
                    <div class="px-5 py-4 border-b border-slate-200 bg-slate-50">
                        <div class="flex items-center justify-between">
                            <h2 class="font-bold text-primary-dark text-heading-sm flex items-center gap-2">
                                <flux:icon.arrow-path class="w-5 h-5 text-blue-500" />
                                In Progress
                            </h2>
                            <span class="bg-blue-100 text-blue-700 text-label-xs font-bold px-2 py-0.5 rounded-full">2 Programs</span>
                        </div>
                        <p class="text-sm text-zinc-500 mt-1">Programs currently undergoing accreditation.</p>
                    </div>
                    <div class="p-0 overflow-x-auto">
                        <table class="w-full text-left text-sm border-collapse whitespace-nowrap">
                            <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-500 font-semibold">
                                <tr>
                                    <th class="px-4 py-3">Program</th>
                                    <th class="px-4 py-3">Current Stage</th>
                                    <th class="px-4 py-3 text-right">Target Date</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <tr class="hover:bg-slate-50">
                                    <td class="px-4 py-3">
                                        <span class="font-bold text-primary">BUCS</span>
                                        <div class="font-medium text-zinc-800">BS Computer Science</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="text-xs font-bold text-blue-700 uppercase tracking-wider">Level IV (Phase 1)</span>
                                        <div class="text-[11px] text-zinc-500 mt-0.5">Self-Survey Document prep</div>
                                    </td>
                                    <td class="px-4 py-3 text-right font-medium text-zinc-700 text-xs">
                                        Nov 15, 2026
                                    </td>
                                </tr>
                                <tr class="hover:bg-slate-50">
                                    <td class="px-4 py-3">
                                        <span class="font-bold text-primary">BUCAL</span>
                                        <div class="font-medium text-zinc-800">BA Broadcasting</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="text-xs font-bold text-amber-600 uppercase tracking-wider">Level III Visit</span>
                                        <div class="text-[11px] text-zinc-500 mt-0.5">Awaiting final board action</div>
                                    </td>
                                    <td class="px-4 py-3 text-right font-medium text-zinc-700 text-xs">
                                        Pending
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                
            </div>
        </div>

        <!-- TAB 1: Programs -->
        <div x-show="activeTab === 'programs'" x-transition x-cloak class="flex flex-col gap-6">
            <!-- Filters -->
            <div class="bg-surface-card rounded-xl border border-slate-200 p-4 flex flex-wrap items-center gap-4 shadow-sm">
                <div class="flex-1 min-w-45">
                    <label class="text-label-xs font-bold text-primary-muted uppercase tracking-wider mb-1.5 block">College / Unit</label>
                    <select class="w-full border border-slate-200 rounded-lg text-body-sm py-2 px-3 focus:ring-brand-orange focus:border-brand-orange bg-white shadow-sm font-medium text-zinc-700">
                        <option>All Colleges</option>
                        <option selected>BUCAL</option>
                        <option>BENG</option>
                    </select>
                </div>
                <div class="flex-1 min-w-45">
                    <label class="text-label-xs font-bold text-primary-muted uppercase tracking-wider mb-1.5 block">Accreditation Level</label>
                    <select class="w-full border border-slate-200 rounded-lg text-body-sm py-2 px-3 focus:ring-brand-orange focus:border-brand-orange bg-white shadow-sm font-medium text-zinc-700">
                        <option>All Levels</option>
                        <option>Level I</option>
                        <option>Level II</option>
                        <option>Level III</option>
                        <option>Level IV</option>
                    </select>
                </div>
                <div class="flex-1 min-w-45">
                    <label class="text-label-xs font-bold text-primary-muted uppercase tracking-wider mb-1.5 block">Search Program</label>
                    <div class="relative">
                        <flux:icon.magnifying-glass class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
                        <input type="text" placeholder="Search by name..." class="w-full border border-slate-200 rounded-lg text-body-sm py-2 pl-9 pr-3 focus:ring-brand-orange focus:border-brand-orange bg-white shadow-sm placeholder:text-slate-400" />
                    </div>
                </div>
            </div>

            <!-- Directory Table -->
            <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden flex flex-col">
                <table class="w-full text-left border-collapse whitespace-nowrap">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200 text-label uppercase tracking-wider text-slate-500">
                            <th class="px-4 py-3 font-bold">College</th>
                            <th class="px-4 py-3 font-bold">Program</th>
                            <th class="px-4 py-3 font-bold">Current Level</th>
                            <th class="px-4 py-3 font-bold text-center">Validity</th>
                            <th class="px-4 py-3 font-bold text-center">Time Left</th>
                            <th class="px-4 py-3 font-bold text-center">Status</th>
                            <th class="px-4 py-3 font-bold text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-body-sm text-zinc-700">
                        <!-- Row 1 -->
                        <tr class="hover:bg-slate-50 transition-colors group cursor-pointer" @click="viewProgram('MA in Literature')">
                            <td class="px-4 py-3 font-bold text-primary">BUCAL</td>
                            <td class="px-4 py-3 font-semibold text-zinc-800">Master of Arts in Literature</td>
                            <td class="px-4 py-3">
                                <span class="bg-primary-light text-white px-2 py-0.5 rounded text-xs font-bold">Level III</span>
                            </td>
                            <td class="px-4 py-3 text-center text-zinc-600 font-mono text-[11px]">Dec 16, 2023 - Dec 15, 2024</td>
                            <td class="px-4 py-3 text-center">
                                <span class="text-rose-600 font-bold text-xs">Expired</span>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-label-xs font-bold tracking-wider uppercase bg-rose-100 text-rose-700">Late</span>
                            </td>
                            <td class="px-4 py-3 text-right">
                                <button class="text-brand-orange font-semibold hover:text-brand-orange-hover flex items-center justify-end gap-1 w-full">
                                    History <flux:icon.chevron-right class="w-3 h-3" />
                                </button>
                            </td>
                        </tr>
                        <!-- Row 2 -->
                        <tr class="hover:bg-slate-50 transition-colors group cursor-pointer" @click="viewProgram('BA in Speech & Theater')">
                            <td class="px-4 py-3 font-bold text-primary">BUCAL</td>
                            <td class="px-4 py-3 font-semibold text-zinc-800">Bachelor of Arts in Speech & Theater</td>
                            <td class="px-4 py-3">
                                <span class="bg-primary text-white px-2 py-0.5 rounded text-xs font-bold">Level IV</span>
                            </td>
                            <td class="px-4 py-3 text-center text-zinc-600 font-mono text-[11px]">July 16, 2024 - July 15, 2028</td>
                            <td class="px-4 py-3 text-center">
                                <span class="text-emerald-600 font-bold text-xs">1 yr, 10 mos</span>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-label-xs font-bold tracking-wider uppercase bg-emerald-100 text-emerald-700">Timely</span>
                            </td>
                            <td class="px-4 py-3 text-right">
                                <button class="text-brand-orange font-semibold hover:text-brand-orange-hover flex items-center justify-end gap-1 w-full">
                                    History <flux:icon.chevron-right class="w-3 h-3" />
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="px-4 py-3 border-t border-slate-200 bg-slate-50/80 text-body-sm text-zinc-500 flex justify-between items-center">
                    <span>Showing 2 of 126 programs</span>
                </div>
            </div>
        </div>

        <!-- TAB 2: Program Accreditation (Vertical Timeline) -->
        <div x-show="activeTab === 'program'" x-transition x-cloak class="flex flex-col gap-6">
            <div class="bg-white border border-slate-200 rounded-xl shadow-sm flex flex-col relative w-full overflow-hidden">
                <div class="px-5 py-4 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
                    <div>
                        <div class="font-bold text-primary-dark flex items-center gap-2 text-heading-sm">
                            <flux:icon.document-text class="w-5 h-5 text-primary" />
                            Accreditation History
                        </div>
                        <p class="text-sm text-zinc-500 mt-1">Showing all recorded visits for <span class="font-semibold text-zinc-800" x-text="selectedProgram"></span></p>
                    </div>
                    <button @click="activeTab = 'programs'" class="text-sm font-semibold text-zinc-500 hover:text-zinc-800 bg-white border border-slate-200 px-3 py-1.5 rounded-lg shadow-sm">
                        Back to Programs
                    </button>
                </div>
                
                <div class="p-6 md:p-8 bg-surface-subtle min-h-[400px]">
                    <!-- Timeline Container -->
                    <div class="relative pl-6 md:pl-8 border-l-[3px] border-slate-200 space-y-10">
                        
                        <!-- Timeline Item: Latest Visit -->
                        <div class="relative">
                            <!-- Timeline Dot -->
                            <div class="absolute -left-[35px] md:-left-[43px] top-1 bg-brand-orange text-white p-1.5 rounded-full ring-4 ring-surface-subtle shadow-sm z-10">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                </svg>
                            </div>
                            
                            <!-- Card Content -->
                            <div class="bg-white border border-slate-200 rounded-xl p-5 md:p-6 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
                                <div class="absolute top-0 right-0 w-2 h-full bg-blue-500"></div>
                                
                                <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4 mb-6">
                                    <div>
                                        <div class="flex items-center gap-3 mb-1">
                                            <h3 class="font-bold text-primary-dark text-lg">3rd Visit (Phase 1)</h3>
                                            <span class="bg-blue-100 text-blue-800 text-label-xs font-bold px-2 py-0.5 rounded uppercase tracking-wider border border-blue-200">Revisit VI</span>
                                        </div>
                                        <p class="text-sm font-medium text-zinc-500 flex items-center gap-1.5">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                            Nov 21 - 25, 2022
                                        </p>
                                    </div>
                                    <div class="text-right">
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-label-xs font-bold tracking-wider uppercase bg-rose-100 text-rose-700 border border-rose-200">
                                            Late Submission
                                        </span>
                                    </div>
                                </div>
                                
                                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                                    <!-- Rating -->
                                    <div class="bg-slate-50 p-4 rounded-lg border border-slate-100 flex flex-col justify-center items-center text-center">
                                        <span class="block text-label-xs text-zinc-400 font-bold uppercase tracking-wider mb-1">Final Rating</span>
                                        <span class="text-2xl font-black text-primary tracking-tight">4.03</span>
                                    </div>
                                    
                                    <!-- Validity -->
                                    <div class="bg-slate-50 p-4 rounded-lg border border-slate-100 flex flex-col justify-center items-center text-center col-span-2 md:col-span-1">
                                        <span class="block text-label-xs text-zinc-400 font-bold uppercase tracking-wider mb-2">Validity Period</span>
                                        <div class="text-sm font-bold text-zinc-700 leading-tight">
                                            Dec 16, 2023 <br>
                                            <span class="text-xs text-zinc-400 font-medium">to</span> <br>
                                            Dec 15, 2024
                                        </div>
                                    </div>
                                    
                                    <!-- Remarks -->
                                    <div class="bg-amber-50/50 p-4 rounded-lg border border-amber-100 col-span-2">
                                        <span class="block text-label-xs text-amber-600/70 font-bold uppercase tracking-wider mb-1">Board Remarks / Actions</span>
                                        <p class="text-sm font-medium text-amber-900 leading-relaxed">
                                            Requested for Resched of Visit on Aug 27-29, 2025.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Timeline Item: Previous Visit -->
                        <div class="relative opacity-75 hover:opacity-100 transition-opacity">
                            <div class="absolute -left-[35px] md:-left-[43px] top-1 bg-slate-300 text-white p-1.5 rounded-full ring-4 ring-surface-subtle shadow-sm z-10">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            </div>
                            
                            <div class="bg-white border border-slate-200 rounded-xl p-5 md:p-6 shadow-sm relative overflow-hidden">
                                <div class="absolute top-0 right-0 w-2 h-full bg-emerald-500"></div>
                                
                                <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4 mb-6">
                                    <div>
                                        <h3 class="font-bold text-primary-dark text-lg mb-1">2nd Visit</h3>
                                        <p class="text-sm font-medium text-zinc-500 flex items-center gap-1.5">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                            Nov 8 - 11, 2017
                                        </p>
                                    </div>
                                    <div class="text-right">
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-label-xs font-bold tracking-wider uppercase bg-emerald-100 text-emerald-700 border border-emerald-200">
                                            Timely
                                        </span>
                                    </div>
                                </div>
                                
                                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                                    <div class="bg-slate-50 p-4 rounded-lg border border-slate-100 flex flex-col justify-center items-center text-center">
                                        <span class="block text-label-xs text-zinc-400 font-bold uppercase tracking-wider mb-1">Final Rating</span>
                                        <span class="text-2xl font-black text-primary tracking-tight">3.63</span>
                                    </div>
                                    <div class="bg-slate-50 p-4 rounded-lg border border-slate-100 flex flex-col justify-center items-center text-center col-span-2 md:col-span-1">
                                        <span class="block text-label-xs text-zinc-400 font-bold uppercase tracking-wider mb-2">Validity Period</span>
                                        <div class="text-sm font-bold text-zinc-700 leading-tight">
                                            Dec 16, 2018 <br>
                                            <span class="text-xs text-zinc-400 font-medium">to</span> <br>
                                            Dec 15, 2022
                                        </div>
                                    </div>
                                    <div class="bg-slate-50 p-4 rounded-lg border border-slate-100 col-span-2 flex items-center justify-center">
                                        <span class="text-sm font-medium text-zinc-400 italic">No additional board remarks.</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 3: Summary Report (Year Filtered) -->
        <div x-show="activeTab === 'summary'" x-transition x-cloak class="flex flex-col gap-6" x-data="{ reportYear: '2023' }">
            <div class="bg-white border border-slate-200 rounded-xl shadow-sm flex flex-col relative w-full overflow-hidden">
                
                <!-- Header & Filters -->
                <div class="px-6 py-5 border-b border-slate-200 bg-slate-50 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                    <div>
                        <h2 class="font-bold text-primary-dark text-heading-sm">AACCUP Technical Review Summary</h2>
                        <p class="text-sm text-zinc-500 mt-1">College breakdown of visits, timeliness, and results.</p>
                    </div>
                    
                    <!-- Year Toggle -->
                    <div class="flex bg-slate-200/80 p-1 rounded-lg border border-slate-200 self-stretch md:self-auto">
                        <template x-for="year in ['2024', '2023', '2022', '2021']">
                            <button @click="reportYear = year" 
                                :class="reportYear === year ? 'bg-white text-primary-dark font-bold shadow-sm ring-1 ring-slate-900/5' : 'text-zinc-500 font-medium hover:text-zinc-700'"
                                class="px-5 py-1.5 rounded-md text-sm transition-all"
                                x-text="year">
                            </button>
                        </template>
                    </div>
                </div>

                <!-- Condensed Table (No horizontal scroll needed) -->
                <div class="w-full">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-primary-dark text-white text-label uppercase tracking-wider">
                                <th rowspan="2" class="px-5 py-3 font-bold border-r border-white/20">College</th>
                                <th rowspan="2" class="px-4 py-3 text-center border-r border-white/20 bg-primary font-bold">Total<br>Visits</th>
                                <th colspan="2" class="px-4 py-2 text-center border-b border-white/20 bg-primary-hover font-bold">Timeliness</th>
                                <th colspan="3" class="px-4 py-2 text-center border-b border-white/20 bg-primary font-bold">Results</th>
                                <th colspan="2" class="px-4 py-2 text-center border-b border-white/20 bg-primary-light font-bold">Pending</th>
                            </tr>
                            <tr class="text-white text-label-xs font-bold tracking-wider">
                                <th class="px-3 py-2 text-center bg-primary-hover border-r border-white/10">Timely</th>
